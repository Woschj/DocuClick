# Blank template — real DocuClick sessions write notes/canvases/docs and
# screenshots into these folders. Keep that out of git so a live-in-place
# vault never leaks captured content into this public repo (see
# VaultTemplate/README.md: copy this folder out first).
/00 Inbox/*
!/00 Inbox/.gitkeep
/01 Prozesse/*
!/01 Prozesse/.gitkeep
/03 MOCs/*
!/03 MOCs/.gitkeep
/99 Archiv/*
!/99 Archiv/.gitkeep
/Attachments/*
!/Attachments/.gitkeep

# Obsidian local/session state — appearance.json and themes/ ARE tracked
# on purpose (that's this template's whole visual point).
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json
/.obsidian/cache
/.obsidian/plugins/
/.obsidian/community-plugins.json
