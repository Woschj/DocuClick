<Window x:Class="DocuClick.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuClick - Einstellungen" Height="820" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI">

    <DockPanel Margin="20">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" DockPanel.Dock="Bottom">
            <Button Content="Abbrechen" Width="100" Margin="0,0,8,0" Style="{StaticResource ModernButton}" IsCancel="True" Click="OnCancelClicked"/>
            <Button Content="Speichern" Width="100" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSaveClicked"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Aufnahme-Verhalten" Style="{StaticResource SectionHeader}"/>

                        <CheckBox x:Name="UseUiAutomationBox" Content="UI-Automation-Beschreibungstexte verwenden" Margin="0,0,0,10"/>
                        <CheckBox x:Name="EnableClickSoundBox" Content="Signalton bei jedem aufgezeichneten Klick" Margin="0,0,0,10"/>
                        <CheckBox x:Name="CaptureOnEnterBox" Content="Auch bei Enter-Taste aufzeichnen (aktives Fenster + fokussiertes Element)" Margin="0,0,0,10"/>
                        <CheckBox x:Name="CaptureOnRightClickBox" Content="Auch bei Rechtsklick aufzeichnen" Margin="0,0,0,12"/>

                        <TextBlock Text="Klicks überspringen bei gedrückter Taste" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="SkipModifierBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                            <ComboBoxItem Content="Keine (immer aufzeichnen)" Tag="None"/>
                            <ComboBoxItem Content="Umschalt (Shift)" Tag="Shift"/>
                            <ComboBoxItem Content="Strg (Control)" Tag="Control"/>
                            <ComboBoxItem Content="Alt" Tag="Alt"/>
                        </ComboBox>

                        <TextBlock Text="Screenshot-Format" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ScreenshotFormatBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                            <ComboBoxItem Content="WebP – klein, gute Qualität (empfohlen)" Tag="WebP"/>
                            <ComboBoxItem Content="JPEG – klein, auch für ältere Programme" Tag="Jpeg"/>
                            <ComboBoxItem Content="PNG – verlustfrei, sehr groß" Tag="Png"/>
                        </ComboBox>

                        <CheckBox x:Name="AutoInstallObsidianPluginBox" Content="Obsidian-Plugin beim Aufnehmen in einen Vault automatisch installieren und aktualisieren" Margin="0,0,0,12"/>

                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Text="Die Zieldatei wird bei jedem Start der Aufnahme abgefragt (neue Datei anlegen oder eine bestehende fortsetzen) — es gibt keinen automatisch generierten Namen mehr."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Aufnahme starten/stoppen" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StartStopDisplayBox" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Content="Ändern" Style="{StaticResource ModernButton}" Click="OnRecordStartStopClicked"/>
                        </Grid>

                        <TextBlock Text="Abzweigung setzen" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BranchMarkDisplayBox" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Content="Ändern" Style="{StaticResource ModernButton}" Click="OnRecordBranchMarkClicked"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,-8,0,12"
                                   Text="Markiert den aktuellen Knoten als Abzweigungspunkt und fragt direkt nach dem Namen des ersten Pfads. Weitere Pfade starten oder bestehende fortsetzen: in der Ablauf-Übersicht auf den Abzweigungspunkt klicken."/>

                        <TextBlock Text="Zoom-auf-Cursor umschalten" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ZoomToCursorDisplayBox" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Content="Ändern" Style="{StaticResource ModernButton}" Click="OnRecordZoomToCursorClicked"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="Auf „Ändern” klicken und die gewünschte Tastenkombination drücken. Esc bricht ab. Änderungen gelten sofort nach „Speichern”."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Highlighter" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="Farbe" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel x:Name="HighlightColorSwatchPanel" Margin="0,0,0,14">
                                <Border Style="{StaticResource ColorSwatchFrame}">
                                    <Button Tag="#E63946" Background="#E63946" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                                </Border>
                                <Border Style="{StaticResource ColorSwatchFrame}">
                                    <Button Tag="#F77F00" Background="#F77F00" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                                </Border>
                                <Border Style="{StaticResource ColorSwatchFrame}">
                                    <Button Tag="#FFD60A" Background="#FFD60A" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                                </Border>
                                <Border Style="{StaticResource ColorSwatchFrame}">
                                    <Button Tag="#22C55E" Background="#22C55E" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                                </Border>
                                <Border Style="{StaticResource ColorSwatchFrame}">
                                    <Button Tag="#1D4ED8" Background="#1D4ED8" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                                </Border>
                                <Border Style="{StaticResource ColorSwatchFrame}">
                                    <Button Tag="#7C3AED" Background="#7C3AED" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                                </Border>
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Radius (px)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="HighlightRadiusBox" Style="{StaticResource ModernTextBox}" TextChanged="OnHighlightPreviewInputChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Strichstärke (px)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="HighlightThicknessBox" Style="{StaticResource ModernTextBox}" TextChanged="OnHighlightPreviewInputChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Column="1" Width="110" Height="110" Background="#14141A" CornerRadius="8"
                                VerticalAlignment="Top" Margin="0,26,0,0" ClipToBounds="True">
                            <Ellipse x:Name="HighlightPreviewEllipse" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
