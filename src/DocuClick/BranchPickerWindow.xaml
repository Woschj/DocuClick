<Window x:Class="DocuClick.BranchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuClick - Branch auswählen" Height="360" Width="380"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,10"
                   Text="Branch wählen, zu dem der nächste Klick springen soll."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" DockPanel.Dock="Bottom">
            <Button Content="Abbrechen" Width="100" Margin="0,0,8,0" Style="{StaticResource ModernButton}" Click="OnCancelClicked" IsCancel="True"/>
            <Button Content="Springen" Width="100" Style="{StaticResource PrimaryButton}" Click="OnSelectClicked" IsDefault="True"/>
        </StackPanel>

        <ListBox x:Name="BranchListBox" Style="{StaticResource ModernListBox}"/>
    </DockPanel>
</Window>
