<Window x:Class="DocuClick.BranchNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuClick - Branch benennen" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI">
    <!-- SizeToContent (rather than a fixed Window Height): a fixed height
         easily squeezes the DockPanel's fill-child (this TextBox, being
         last) down to a sliver once title-bar chrome is subtracted from it. -->
    <DockPanel Margin="18">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" DockPanel.Dock="Bottom">
            <Button Content="Abbrechen" Width="100" Margin="0,0,8,0" Style="{StaticResource ModernButton}" Click="OnCancelClicked" IsCancel="True"/>
            <Button Content="Setzen" Width="100" Style="{StaticResource PrimaryButton}" Click="OnSetClicked" IsDefault="True"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Branch-Name" Style="{StaticResource FieldLabel}"/>

        <TextBox x:Name="BranchNameBox" DockPanel.Dock="Top" Style="{StaticResource ModernTextBox}"
                 ToolTip="z. B. &quot;Login-Fehler&quot; — später über &quot;Branch auswählen&quot; wiederfindbar."/>
    </DockPanel>
</Window>
