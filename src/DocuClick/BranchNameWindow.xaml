<Window x:Class="DocuClick.BranchNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuClick - Branch benennen" Height="160" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    <DockPanel Margin="16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" DockPanel.Dock="Bottom">
            <Button Content="Abbrechen" Width="90" Margin="0,0,8,0" Click="OnCancelClicked" IsCancel="True"/>
            <Button Content="Setzen" Width="90" Click="OnSetClicked" IsDefault="True"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Name für diesen Abzweigungspunkt (z. B. &quot;Login-Fehler&quot;) — darüber lässt er sich später über &quot;Branch auswählen&quot; gezielt wiederfinden."/>

        <TextBox x:Name="BranchNameBox" DockPanel.Dock="Top"/>
    </DockPanel>
</Window>
