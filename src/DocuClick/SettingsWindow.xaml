<Window x:Class="DocuClick.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuClick - Einstellungen" Height="820" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI">

    <DockPanel Margin="20">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" DockPanel.Dock="Bottom">
            <Button Content="Abbrechen" Width="100" Margin="0,0,8,0" Style="{StaticResource ModernButton}" Click="OnCancelClicked"/>
            <Button Content="Speichern" Width="100" Style="{StaticResource PrimaryButton}" Click="OnSaveClicked"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Ausgabeformat" Style="{StaticResource SectionHeader}"/>

                        <RadioButton x:Name="OutputModeNoteRadio" GroupName="OutputMode" Margin="0,0,0,8"
                                     Content="Notiz (Markdown, an eine .md-Datei anhängen)"
                                     Checked="OnOutputModeChanged"/>
                        <RadioButton x:Name="OutputModeCanvasRadio" GroupName="OutputMode" Margin="0,0,0,8"
                                     Content="Obsidian-Canvas (.canvas, Ablaufdiagramm mit Abzweigungen)"
                                     Checked="OnOutputModeChanged"/>
                        <RadioButton x:Name="OutputModeExcalidrawRadio" GroupName="OutputMode" Margin="0,0,0,8"
                                     Content="Excalidraw (.excalidraw, Skizzen-Look, experimentell — benötigt das Excalidraw-Plugin)"
                                     Checked="OnOutputModeChanged"/>
                        <RadioButton x:Name="OutputModeDrawIoRadio" GroupName="OutputMode" Margin="0,0,0,4"
                                     Content="draw.io (.drawio, echtes editierbares Flowchart mit Kartenlayout, kein Obsidian nötig)"
                                     Checked="OnOutputModeChanged"/>

                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Canvas schreibt jeden Klick als verbundenen Knoten auf einer Fläche (vertikaler Hauptfluss, Abzweigungspunkte mit neuen Pfaden als Spalten, gesteuert über die Ablauf-Übersicht) — gut für kurze Abläufe, wird bei sehr langen Abläufen aber schnell unübersichtlich. Excalidraw funktioniert wie Canvas (Knoten + Abzweigungen), aber im freien Skizzen-Look statt fester Boxen — experimentell, benötigt zusätzlich das kostenlose Excalidraw-Community-Plugin (anders als Canvas, das in Obsidian bereits eingebaut ist). draw.io zeichnet wie Canvas ein Flussdiagramm (Hauptfluss + Abzweigungen als Spalten), aber als echte Karten mit Nummer-Badge, Beschriftung und Screenshot als eine verschiebbare Einheit, mit farbigen Pfeilen je Pfad — öffnet in der kostenlosen draw.io/diagrams.net-App, ganz ohne Obsidian. Canvas/Excalidraw/draw.io betten Screenshots direkt in die Datei ein — kein separater Attachments-Ordner nötig — und sind voll editierbar."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="VaultCardHeader" Text="Obsidian-Vault" Style="{StaticResource SectionHeader}"/>

                        <TextBlock x:Name="VaultPathLabel" Text="Vault-Pfad" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button Content="Durchsuchen..." DockPanel.Dock="Right" Margin="8,0,0,0"
                                    Style="{StaticResource ModernButton}" Click="OnBrowseVaultClicked"/>
                            <TextBox x:Name="VaultPathBox" Style="{StaticResource ModernTextBox}"/>
                        </DockPanel>

                        <StackPanel x:Name="AttachmentsRow">
                            <TextBlock Text="Attachments-Unterordner" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AttachmentsFolderBox" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Aufnahme-Verhalten" Style="{StaticResource SectionHeader}"/>

                        <CheckBox x:Name="UseUiAutomationBox" Content="UI-Automation-Beschreibungstexte verwenden" Margin="0,0,0,10"/>
                        <CheckBox x:Name="EnableClickSoundBox" Content="Signalton bei jedem aufgezeichneten Klick" Margin="0,0,0,10"/>
                        <CheckBox x:Name="CaptureOnEnterBox" Content="Auch bei Enter-Taste aufzeichnen (aktives Fenster + fokussiertes Element)" Margin="0,0,0,10"/>
                        <CheckBox x:Name="CaptureOnRightClickBox" Content="Auch bei Rechtsklick aufzeichnen" Margin="0,0,0,12"/>

                        <TextBlock Text="Klicks überspringen bei gedrückter Taste" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="SkipModifierBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                            <ComboBoxItem Content="Keine (immer aufzeichnen)" Tag="None"/>
                            <ComboBoxItem Content="Umschalt (Shift)" Tag="Shift"/>
                            <ComboBoxItem Content="Strg (Control)" Tag="Control"/>
                            <ComboBoxItem Content="Alt" Tag="Alt"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Text="Die Zieldatei wird bei jedem Start der Aufnahme abgefragt (neue Datei anlegen oder eine bestehende fortsetzen) — es gibt keinen automatisch generierten Namen mehr."/>

                        <TextBlock Text="Zoom-auf-Cursor: Radius in Pixeln" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="ZoomToCursorRadiusBox" Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Text="Per Hotkey umschaltbar (siehe unten): erfasst statt des ganzen geklickten Fensters nur ein Quadrat mit diesem Radius rund um den Mauszeiger — nützlich, um kleine Bedienelemente größer sichtbar zu machen."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Aufnahme starten/stoppen" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StartStopDisplayBox" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Content="Ändern" Style="{StaticResource ModernButton}" Click="OnRecordStartStopClicked"/>
                        </Grid>

                        <TextBlock Text="Abzweigung setzen" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BranchMarkDisplayBox" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Content="Ändern" Style="{StaticResource ModernButton}" Click="OnRecordBranchMarkClicked"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,-8,0,12"
                                   Text="Markiert den aktuellen Knoten als Abzweigungspunkt. Neuen Pfad starten oder bestehenden fortsetzen: in der Ablauf-Übersicht auf den Abzweigungspunkt klicken."/>

                        <TextBlock Text="Zoom-auf-Cursor umschalten" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ZoomToCursorDisplayBox" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
                            <Button Grid.Column="1" Content="Ändern" Style="{StaticResource ModernButton}" Click="OnRecordZoomToCursorClicked"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Text="Auf „Ändern” klicken und die gewünschte Tastenkombination drücken. Esc bricht ab. Änderungen gelten sofort nach „Speichern”."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Highlighter" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Farbe" Style="{StaticResource FieldLabel}"/>
                        <StackPanel x:Name="HighlightColorSwatchPanel" Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Tag="#E63946" Background="#E63946" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                            <Button Tag="#F77F00" Background="#F77F00" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                            <Button Tag="#FFD60A" Background="#FFD60A" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                            <Button Tag="#22C55E" Background="#22C55E" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                            <Button Tag="#1D4ED8" Background="#1D4ED8" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                            <Button Tag="#7C3AED" Background="#7C3AED" Style="{StaticResource ColorSwatchButton}" Click="OnHighlightColorSwatchClicked"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Radius (px)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="HighlightRadiusBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Strichstärke (px)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="HighlightThicknessBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
