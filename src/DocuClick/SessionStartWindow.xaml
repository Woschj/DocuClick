<Window x:Class="DocuClick.SessionStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuClick - Session starten" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI">
    <DockPanel Margin="20" LastChildFill="False">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,14"
                   Text="Jede Aufnahme-Session braucht eine Zieldatei — neue Datei anlegen oder eine bestehende fortsetzen, statt eines generischen Namens."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" DockPanel.Dock="Bottom">
            <Button Content="Abbrechen" Width="100" Margin="0,0,8,0" Style="{StaticResource ModernButton}" IsCancel="True" Click="OnCancelClicked"/>
            <Button Content="Starten" Width="100" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnStartClicked"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <RadioButton x:Name="NewFileRadio" GroupName="Mode" Content="Neue Datei anlegen" IsChecked="True"
                                 Checked="OnModeChanged" Margin="0,0,0,10"/>

                    <TextBlock Text="Speicherort" Style="{StaticResource FieldLabel}" Margin="20,0,0,4"/>
                    <DockPanel Margin="20,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Durchsuchen..." Width="110" Margin="8,0,0,0"
                                Style="{StaticResource ModernButton}" Click="OnBrowseFolderClicked"/>
                        <TextBox x:Name="TargetFolderBox" Style="{StaticResource ModernTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False"/>
                    </DockPanel>

                    <TextBlock Text="Dateiname" Style="{StaticResource FieldLabel}" Margin="20,0,0,4"/>
                    <TextBox x:Name="NewFileNameBox" Style="{StaticResource ModernTextBox}" Margin="20,0,0,4"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="20,0,0,0"
                               Text="Die .html-Datei und ihr Attachments-Unterordner werden direkt in diesem Ordner angelegt."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <RadioButton x:Name="ExistingFileRadio" GroupName="Mode" Content="Bestehende Datei fortsetzen"
                                 Checked="OnModeChanged" Margin="0,0,0,10"/>

                    <TextBlock Text="Datei" Style="{StaticResource FieldLabel}" Margin="20,0,0,4"/>
                    <DockPanel Margin="20,0,0,0">
                        <Button DockPanel.Dock="Right" Content="Durchsuchen..." Width="110" Margin="8,0,0,0"
                                Style="{StaticResource ModernButton}" Click="OnBrowseExistingFileClicked"/>
                        <TextBox x:Name="ExistingFileBox" Style="{StaticResource ModernTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
