<Window x:Class="DocuClick.SessionStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuClick - Session starten" Height="460" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,14"
                   Text="Jede Aufnahme-Session braucht eine Zieldatei — neue Datei anlegen oder eine bestehende fortsetzen, statt eines generischen Namens."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" DockPanel.Dock="Bottom">
            <Button Content="Abbrechen" Width="100" Margin="0,0,8,0" Style="{StaticResource ModernButton}" Click="OnCancelClicked"/>
            <Button Content="Starten" Width="100" Style="{StaticResource PrimaryButton}" Click="OnStartClicked"/>
        </StackPanel>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top">
            <StackPanel>
                <RadioButton x:Name="NewFileRadio" GroupName="Mode" Content="Neue Datei anlegen" IsChecked="True"
                             Checked="OnModeChanged" Margin="0,0,0,10"/>
                <TextBlock Text="Dateiname" Style="{StaticResource FieldLabel}" Margin="20,0,0,4"/>
                <TextBox x:Name="NewFileNameBox" Style="{StaticResource ModernTextBox}" Margin="20,0,0,10"/>
                <TextBlock Text="Zielordner (relativ, leer = Vault-Root — Vorschläge aus vorhandenen Ordnern, oder neuen Namen eintippen)"
                           Style="{StaticResource HintText}" Margin="20,0,0,4"/>
                <ComboBox x:Name="TargetFolderBox" Style="{StaticResource ModernComboBox}" Margin="20,0,0,12" IsEditable="True"/>

                <RadioButton x:Name="ExistingFileRadio" GroupName="Mode" Content="Bestehende Datei fortsetzen"
                             Checked="OnModeChanged"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="ExistingFilesListBox" Style="{StaticResource ModernListBox}"/>
    </DockPanel>
</Window>
