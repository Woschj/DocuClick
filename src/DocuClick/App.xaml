<Application x:Class="DocuClick.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No StartupUri / MainWindow: DocuClick runs headless from the tray. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared design system (colors, card/button/textbox/listbox
                     styles) for every dialog window, so Settings, session
                     start, and the branch/resume/name dialogs all look like
                     one app instead of each rolling its own look. -->
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
